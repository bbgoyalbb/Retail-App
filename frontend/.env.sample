# Copy this file to .env before starting the frontend dev server:
#   cp frontend/.env.sample frontend/.env
#
# REACT_APP_BACKEND_URL — optional explicit FastAPI base URL (no trailing slash).
#   If omitted, the frontend uses its current hostname on port 8001. This works
#   for localhost, LAN IPs, and configured public/static IPs.
# REACT_APP_BACKEND_URL=https://YOUR_SERVER_IP:8001

# REACT_APP_ENABLE_SEED — set to "true" to enable the DB seed button in DataManager
REACT_APP_ENABLE_SEED=false
